# CyberRemediate 360 - example configuration (copy to .env; never commit .env)
# demo | production   (production refuses writes when no API key is set)
CR360_APP_ENV=demo
# SQLAlchemy URL. Default: sqlite:///<project>/data/cyberremediate.db
# CR360_DATABASE_URL=sqlite:///D:/CyberRemediate360/data/cyberremediate.db
# Optional shared key required by write endpoints (X-API-Key). Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CR360_API_KEY=
# Allowed browser origins (JSON list)
CR360_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
CR360_MAX_UPLOAD_BYTES=5242880
CR360_MAX_IMPORT_ROWS=50000
# Scoring / SLA overrides (nested with __), e.g.:
# CR360_SCORING__EXPOSURE_INTERNET=20
# CR360_SLA__P1_DAYS=7
# Streamlit -> API base URL
CR360_API_URL=http://127.0.0.1:8000/api/v1
